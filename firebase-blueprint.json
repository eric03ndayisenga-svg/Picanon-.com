  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Role documents granting admin access to verified admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "PII-isolated member accounts readable only by the owning user or an admin."
    },
    "/recharges/{rechargeId}": {
      "schema": { "$ref": "#/entities/RechargeRequest" },
      "description": "Deposit queue managed by admins with terminal state locking."
    },
    "/withdrawals/{withdrawId}": {
      "schema": { "$ref": "#/entities/WithdrawRequest" },
      "description": "Withdrawal payout queue managed by admins with terminal state locking."
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/InvestmentRecord" },
      "description": "Active and completed VIP package investments per member."
    },
    "/redemptionCodes/{codeId}": {
      "schema": { "$ref": "#/entities/RedemptionCode" },
      "description": "Company gift voucher codes created and toggled by admins."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AdminSettings" },
      "description": "Platform MoMo/Airtel numbers, fee rates, and broadcast announcements."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "Member transaction ledger entries synced for cross-device audit and recovery."
    }
  }
}
