{
  "entities": {
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized platform administrator document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 128
        },
        "phone": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^[0-9+\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Registered Picanon member account synced for cross-device access and Admin oversight.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phone": {
          "type": "string",
          "minLength": 9,
          "maxLength": 24,
          "pattern": "^[0-9+\\-]+$"
        },
        "balance": {
          "type": "number"
        },
        "totalIncome": {
          "type": "number"
        },
        "totalWithdrawn": {
          "type": "number"
        },
        "totalRecharged": {
          "type": "number"
        },
        "vipLevel": {
          "type": "integer"
        },
        "referralCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referredBy": {
          "type": "string",
          "maxLength": 32
        },
        "isAdmin": {
          "type": "boolean"
        },
        "isBanned": {
          "type": "boolean"
        },
        "teamCountLevel1": {
          "type": "integer"
        },
        "teamCountLevel2": {
          "type": "integer"
        },
        "teamCountLevel3": {
          "type": "integer"
        },
        "teamCommission": {
          "type": "number"
        },
        "freeSpins": {
          "type": "integer"
        },
        "hasClaimedWelcomeBonus": {
          "type": "boolean"
        },
        "lastCheckInDate": {
          "type": "string",
          "maxLength": 32
        },
        "payoutMethod": {
          "type": "string",
          "enum": ["mtn", "airtel"],
          "maxLength": 16
        },
        "payoutPhone": {
          "type": "string",
          "maxLength": 24
        },
        "payoutName": {
          "type": "string",
          "maxLength": 64
        },
        "createdAtText": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "phone",
        "balance",
        "totalIncome",
        "totalWithdrawn",
        "totalRecharged",
        "vipLevel",
        "referralCode",
        "isAdmin",
        "createdAt",
        "updatedAt"
      ]
    },
